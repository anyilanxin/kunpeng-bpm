  },
  "dependencies": {
    "@kunpeng-io/form-js": "workspace:*",
    "@kunpeng-io/form-js-vue": "workspace:*",
    "sortablejs": "catalog:"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "element-plus": "^2.9.0"
  },
  "devDependencies": {
    "@types/sortablejs": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "element-plus": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "^2.1.0"
  }
}
