{
  "name": "@kunpeng-io/dmn-js",
  "version": "0.1.0",
  "description": "DMN 1.3 命名空间域决策建模器组件（diagram-js 基座，DRD 决策需求图 / 决策表 / 表达式视图，kunpeng 扩展命名空间内置）",
  "license": "GPL-2.0-only WITH CLASSPATH-EXCEPTION-2.0",
  "type": "module",
  "main": "./dist/dmn-js.cjs",
  "module": "./dist/dmn-js.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/dmn-js.es.js",
      "require": "./dist/dmn-js.cjs"
    },
    "./styles": "./dist/styles/dmn-js.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "licenses"
  ],
  "scripts": {
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/prepare-dist.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "@kunpeng-io/kunpeng-bpmn-moddle": "workspace:*",
    "@kunpeng-io/kunpeng-dmn-moddle": "workspace:*",
    "bpmn-moddle": "^10.3.1",
    "inherits-browser": "^0.1.0",
    "diagram-js": "catalog:",
    "diagram-js-direct-editing": "catalog:",
    "didi": "^11.0.1",
    "dmn-moddle": "catalog:",
    "htm": "^3.1.1",
    "ids": "catalog:",
    "min-dash": "catalog:",
    "min-dom": "catalog:",
    "moddle": "^8.2.1",
    "moddle-xml": "^12.3.1",
    "tiny-svg": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
