{
  "name": "@kunpeng-io/bpmn-js-element-templates",
  "version": "2026.11.1",
  "description": "Element templates for bpmn-js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./core": {
      "import": "./dist/core.esm.js",
      "require": "./dist/core.js"
    },
    "./dist/assets/*.css": "./dist/assets/*.css",
    "./dist/*.js": "./dist/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && vite build",
    "clean": "rimraf dist"
  },
  "engines": {
    "node": "*"
  },
  "keywords": [
    "bpmn-io",
    "bpmn-js",
    "properties",
    "properties-panel",
    "element-templates"
  ],
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "author": {
    "name": "Nico Rehwaldt",
    "url": "https://github.com/nikku"
  },
  "contributors": [
    {
      "name": "bpmn.io contributors",
      "url": "https://github.com/bpmn-io"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "@kunpeng-io/element-templates-validator": "workspace:*",
    "@kunpeng-io/extract-process-variables": "workspace:*",
    "bpmn-moddle": "catalog:",
    "bpmnlint": "catalog:",
    "classnames": "catalog:",
    "ids": "catalog:",
    "min-dash": "catalog:",
    "min-dom": "catalog:",
    "preact-markup": "catalog:",
    "semver": "catalog:",
    "semver-compare": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "catalog:",
    "@kunpeng-io/bpmn-js": "workspace:*",
    "@kunpeng-io/bpmn-js-properties-panel": "workspace:*",
    "@kunpeng-io/kunpeng-bpmn-moddle": "workspace:*",
    "@kunpeng-io/properties-panel": "workspace:*",
    "fs-extra": "catalog:",
    "rimraf": "catalog:",
    "vite": "catalog:",
    "vite-plugin-babel": "catalog:"
  },
  "peerDependencies": {
    "@kunpeng-io/bpmn-js": "*",
    "diagram-js": ">= 11.9"
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
