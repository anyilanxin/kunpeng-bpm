{
  "name": "@kunpeng-io/properties-panel",
  "version": "2026.10.3",
  "description": "Library for creating bpmn-io properties panels.",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./assets/*": "./assets/*",
    "./preact": {
      "default": "./preact/index.js"
    },
    "./preact/hooks": {
      "default": "./preact/hooks/index.js"
    },
    "./preact/compat": {
      "default": "./preact/compat/index.js"
    },
    "./preact/jsx-runtime": {
      "default": "./preact/jsx-runtime/index.js"
    },
    "./preact/jsx-dev-runtime": {
      "default": "./preact/jsx-dev-runtime/index.js"
    },
    "./preact/*": "./preact/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "preact"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "rimraf dist"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "*"
  },
  "author": "Niklas Kiefer <niklas.kiefer@camunda.com> (https://github.com/pinussilvestrus)",
  "contributors": [
    {
      "name": "bpmn.io contributors",
      "url": "https://github.com/bpmn-io"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "@carbon/icons": "catalog:",
    "@codemirror/autocomplete": "catalog:",
    "@codemirror/commands": "catalog:",
    "@codemirror/lang-json": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/lint": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "classnames": "catalog:",
    "focus-trap": "catalog:",
    "min-dash": "catalog:",
    "min-dom": "catalog:",
    "preact": "catalog:",
    "@kunpeng-io/expression-editor": "workspace:*"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plugin-babel": "catalog:",
    "@babel/plugin-transform-react-jsx": "catalog:",
    "babel-plugin-inline-react-svg": "catalog:",
    "babel-plugin-module-resolver": "catalog:",
    "rimraf": "catalog:",
    "@babel/core": "catalog:"
  },
  "types": "./dist/index.d.ts"
}
