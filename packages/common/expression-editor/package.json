{
  "name": "@kunpeng-io/expression-editor",
  "version": "2026.10.3",
  "description": "Editor for FEEL expressions.",
  "type": "module",
  "main": "./dist/index.js",
  "source": "./src/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && vite build",
    "clean": "rimraf dist"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">= 20"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "bpmn-io",
    "feel",
    "editor"
  ],
  "author": {
    "name": "Martin Stamm",
    "url": "https://github.com/marstamm"
  },
  "contributors": [
    {
      "name": "bpmn.io contributors",
      "url": "https://github.com/bpmn-io"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "@bpmn-io/cm-theme": "catalog:",
    "@codemirror/autocomplete": "catalog:",
    "@codemirror/commands": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/lint": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@lezer/highlight": "catalog:",
    "min-dom": "catalog:",
    "mitt": "catalog:",
    "@kunpeng-io/expression-builtins": "workspace:*",
    "@kunpeng-io/expression-lint": "workspace:*",
    "@kunpeng-io/lang-expression": "workspace:*"
  },
  "devDependencies": {
    "vite": "catalog:",
    "rimraf": "catalog:"
  },
  "types": "./dist/index.d.ts"
}
